// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum AssignmentType {
  FILE_UPLOAD
  CBT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum SubmissionStatus {
  PENDING
  MARKED
  RETURNED
}

enum EvaluationStatus {
  EXCELLENT
  SATISFACTORY
  NEEDS_REVISION
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  password String
  role     Role

  // Relations (back-references)
  assignments    Assignment[]    @relation("TeacherAssignments")
  submissions    Submission[]    @relation("StudentSubmissions")
  inlineComments InlineComment[] @relation("TeacherComments")
}

model Assignment {
  id          String         @id @default(uuid())
  title       String
  description String
  type        AssignmentType
  dueDate     DateTime
  teacherId   String

  teacher     User           @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  questions   Question[]
  submissions Submission[]
}

model Question {
  id            String       @id @default(uuid())
  assignmentId  String
  type          QuestionType
  prompt        String
  options       Json?
  correctAnswer String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  answers    Answer[]
}

model Submission {
  id              String            @id @default(uuid())
  assignmentId    String
  studentId       String
  status          SubmissionStatus  @default(PENDING)
  evaluation      EvaluationStatus?
  score           Float?
  generalFeedback String?
  fileUrl         String?
  version         Int               @default(1)

  assignment     Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User            @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  answers        Answer[]
  inlineComments InlineComment[]
}

model Answer {
  id             String   @id @default(uuid())
  submissionId   String
  questionId     String
  studentResponse String
  isCorrect      Boolean?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InlineComment {
  id           String @id @default(uuid())
  submissionId String
  teacherId    String
  text         String
  xCoordinate  Float
  yCoordinate  Float

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher    User       @relation("TeacherComments", fields: [teacherId], references: [id], onDelete: Restrict)
}
